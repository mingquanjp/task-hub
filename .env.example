# Copy the Neon direct connection string here without modifying its scheme.
# Keep sslmode=require and channel_binding=require from the Neon connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=taskhub
JWT_AUDIENCE=taskhub-api
